# Backend server
PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Paper trading
INITIAL_BALANCE=1000000

# Database
# If DATABASE_URL is set, backend uses Postgres (Supabase/Neon/etc)
# Example (Supabase): postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Example (Neon):     postgresql://<user>:<password>@<project>.neon.tech/<db>?sslmode=require
DATABASE_URL=

# Fallback for local/dev when DATABASE_URL is not set (sql.js/SQLite file export)
DB_PATH=./database.sqlite

# AI (Gemini)
GEMINI_API_KEY=your-gemini-api-key

# Auto-Invest scheduler (optional)
# Set to "false" to disable cron-based auto research/execute
AUTO_INVEST_CRON_ENABLED=true
# Weekdays 08:45 local time
AUTO_INVEST_RESEARCH_CRON=45 8 * * 1-5
# Weekdays 09:16 local time
AUTO_INVEST_EXECUTE_CRON=16 9 * * 1-5
